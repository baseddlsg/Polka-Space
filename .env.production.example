# VR Genesis Frame - Production Environment Configuration
# Copy this file to .env.production and update with your actual values

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application Info
VITE_APP_NAME=VR Genesis Frame
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Create, customize, and mint 3D objects as NFTs on Polkadot

# Environment
NODE_ENV=production
VITE_NODE_ENV=production

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Backend API
VITE_API_BASE_URL=https://api.vrgenesisframe.com
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3

# Server Configuration (Backend)
PORT=3001
HOST=0.0.0.0
API_PREFIX=/api/v1

# =============================================================================
# BLOCKCHAIN CONFIGURATION
# =============================================================================

# Polkadot Network
VITE_POLKADOT_WS_URL=wss://rpc.polkadot.io
VITE_POLKADOT_HTTP_URL=https://rpc.polkadot.io
POLKADOT_WS_URL=wss://rpc.polkadot.io
POLKADOT_HTTP_URL=https://rpc.polkadot.io

# Kusama Network
VITE_KUSAMA_WS_URL=wss://kusama-rpc.polkadot.io
VITE_KUSAMA_HTTP_URL=https://kusama-rpc.polkadot.io
KUSAMA_WS_URL=wss://kusama-rpc.polkadot.io
KUSAMA_HTTP_URL=https://kusama-rpc.polkadot.io

# Asset Hub (Primary Network)
VITE_ASSETHUB_WS_URL=wss://polkadot-asset-hub-rpc.polkadot.io
VITE_ASSETHUB_HTTP_URL=https://polkadot-asset-hub-rpc.polkadot.io
ASSETHUB_WS_URL=wss://polkadot-asset-hub-rpc.polkadot.io
ASSETHUB_HTTP_URL=https://polkadot-asset-hub-rpc.polkadot.io

# Default Network
VITE_DEFAULT_NETWORK=assethub
DEFAULT_NETWORK=assethub

# Connection Settings
VITE_BLOCKCHAIN_CONNECTION_TIMEOUT=10000
VITE_BLOCKCHAIN_MAX_RECONNECT_ATTEMPTS=5
BLOCKCHAIN_CONNECTION_TIMEOUT=10000
BLOCKCHAIN_MAX_RECONNECT_ATTEMPTS=5

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/vrgenesisframe
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=vrgenesisframe
DATABASE_USER=vrgenesis
DATABASE_PASSWORD=your-secure-database-password
DATABASE_SSL=true
DATABASE_MAX_CONNECTIONS=20

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# IPFS Configuration
IPFS_API_URL=https://ipfs.infura.io:5001
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
IPFS_PROJECT_ID=your-infura-project-id
IPFS_PROJECT_SECRET=your-infura-project-secret

# File Upload
VITE_MAX_FILE_SIZE=52428800
VITE_ALLOWED_FILE_TYPES=glb,gltf,obj,fbx,png,jpg,jpeg
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=glb,gltf,obj,fbx,png,jpg,jpeg

# CDN Configuration
VITE_CDN_URL=https://cdn.vrgenesisframe.com
CDN_URL=https://cdn.vrgenesisframe.com

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=https://vrgenesisframe.com,https://www.vrgenesisframe.com,https://app.vrgenesisframe.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MINTING_MAX_REQUESTS=10
RATE_LIMIT_UPLOAD_MAX_REQUESTS=5

# Security Headers
ENABLE_HELMET=true
ENABLE_CORS=true
ENABLE_CSP=true
ENABLE_HSTS=true

# Content Security Policy
CSP_SCRIPT_SRC='self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net
CSP_STYLE_SRC='self' 'unsafe-inline' https://fonts.googleapis.com
CSP_FONT_SRC='self' https://fonts.gstatic.com
CSP_IMG_SRC='self' data: https: blob:
CSP_CONNECT_SRC='self' wss: https:

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# 3D Model Optimization
VITE_MAX_CONCURRENT_MODELS=3
VITE_MODEL_CACHE_SIZE=30
VITE_QUERY_BATCH_SIZE=5
VITE_RENDER_DISTANCE=100
VITE_ENABLE_LOD=true
VITE_ENABLE_OCCLUSION=true

MAX_CONCURRENT_MODELS=3
MODEL_CACHE_SIZE=30
QUERY_BATCH_SIZE=5
RENDER_DISTANCE=100
ENABLE_LOD=true
ENABLE_OCCLUSION=true

# Caching
CACHE_TTL=300
CACHE_MAX_SIZE=1000
ENABLE_REDIS_CACHE=true

# Query Optimization
QUERY_TIMEOUT=30000
MAX_CONCURRENT_QUERIES=10
ENABLE_QUERY_BATCHING=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Core Features
VITE_ENABLE_VR=true
VITE_ENABLE_AR=false
VITE_ENABLE_3D_EDITOR=true
VITE_ENABLE_NFT_MINTING=true
VITE_ENABLE_PORTFOLIO=true
VITE_ENABLE_COMMUNITY=true

# Advanced Features
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_PWA=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true

# Experimental Features
VITE_ENABLE_AI_GENERATION=false
VITE_ENABLE_MULTIPLAYER=false
VITE_ENABLE_STREAMING=false

# =============================================================================
