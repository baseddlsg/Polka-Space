# Backend API URL
# For development
VITE_API_URL=http://localhost:3001

# For production, use your deployed backend URL
# VITE_API_URL=https://api.polka-space.com

# IPFS Configuration
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/
VITE_IPFS_API=https://ipfs.infura.io:5001

# NFT.Storage API Key (optional, for IPFS uploads)
# Get your key from https://nft.storage
# VITE_NFT_STORAGE_KEY=your_api_key_here

# Application Configuration
VITE_APP_NAME=Polka-Space
VITE_APP_VERSION=2.0.0

# Feature Flags
VITE_ENABLE_VR=true
VITE_ENABLE_ANALYTICS=false

# Blockchain Configuration
VITE_DEFAULT_CHAIN=assethub
VITE_SUPPORTED_CHAINS=assethub,unique,astar

# Development Mode
VITE_DEV_MODE=true
