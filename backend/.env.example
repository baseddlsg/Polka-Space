# AssetHub/Westmint RPC Endpoint
# For testnet (Westmint):
ASSETHUB_ENDPOINT_URL=wss://westmint-rpc.polkadot.io
# For mainnet (Statemint):
# ASSETHUB_ENDPOINT_URL=wss://statemint-rpc.polkadot.io

# Alternative variable name (legacy support)
STATEMINT_ENDPOINT_URL=wss://westmint-rpc.polkadot.io

# NFT Collection ID
# This collection must already exist on the chain
# Create a collection first using Polkadot.js Apps or similar tool
NFT_COLLECTION_ID=1

# Server Account Seed
# For development/testing, you can use test accounts like //Alice
# For production, use a secure seed phrase and NEVER commit it
# Example: //Alice, //Bob, or a proper mnemonic phrase
SERVER_ACCOUNT_SEED=//Alice

# Server Port
PORT=3001

# Redis Configuration (optional, for caching)
# If not provided, caching will be disabled
REDIS_URL=redis://localhost:6379

# Node Environment
NODE_ENV=development

# CORS Origins (comma-separated)
# For development, allow localhost
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Level
LOG_LEVEL=info
